{
  "name": "CareTeamMembership",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "display_name": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "revoked"
      ],
      "default": "pending"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}