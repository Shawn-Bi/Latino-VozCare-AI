{
  "name": "Visit",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "required": true
    },
    "assigned_doctor_id": {
      "type": "string",
      "required": true
    },
    "completed_at": {
      "type": "string",
      "required": true
    },
    "appointment_starts_at": {
      "type": "string",
      "required": true
    },
    "appointment_ends_at": {
      "type": "string",
      "required": true
    },
    "appointment_time_zone": {
      "type": "string",
      "default": "America/New_York"
    },
    "appointment_hospital": {
      "type": "string",
      "required": true
    },
    "appointment_address": {
      "type": "string",
      "required": true
    },
    "doctor_source_note": {
      "type": "string",
      "default": ""
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}