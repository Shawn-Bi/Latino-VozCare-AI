{
  "name": "VozCare AI",
  "description": "Synthetic-data VozCare prototype: Google sign-in, admin-approved care-team memberships, and education drafts. Patient records stay locked to doctors until a secure backend operation exists. SMS, calls, patient links, and final approval are not connected.",
  "site": {
    "outputDirectory": "dist",
    "buildCommand": "npm run build",
    "serveCommand": "npm run dev",
    "installCommand": "npm ci"
  }
}